# Postgres connection string (Vercel → Storage → Neon sets this automatically on deploy).
# Local dev: paste a Neon connection string here, or leave it unset to use the
# in-memory store (reports reset every restart).
DATABASE_URL=

# POSTGRES_URL is also accepted (Vercel's older variable name).
# POSTGRES_URL=

# Public base URL — used for canonical links, sitemap.xml and robots.txt.
# No production domain yet; defaults to the placeholder https://roltrapstuk.vercel.app
# when unset. Set this to the real URL once the site is deployed.
NEXT_PUBLIC_SITE_URL=
